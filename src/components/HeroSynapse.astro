    <path class="pool" style="--po:.12" fill="var(--green)" d="M1010,360 C1036,322 1122,326 1146,368 C1170,410 1126,448 1066,440 C1006,432 984,398 1010,360 Z" />
    <path class="pool" style="--po:.10" fill="var(--wood)" d="M580,490 C620,432 780,438 820,504 C860,570 776,620 668,608 C560,596 540,548 580,490 Z" />
    <path class="pool" style="--po:.10" fill="var(--green)" d="M60,560 C86,522 168,526 190,566 C212,606 172,642 116,636 C60,630 34,598 60,560 Z" />
  </g>

  <!-- Strands: axons and dendrites. pathLength=1 normalizes the draw-on. -->

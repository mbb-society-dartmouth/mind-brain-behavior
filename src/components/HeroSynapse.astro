    <path class="st g1" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M468,77 C459,42 466,8 454,-30" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="2" d="M610,158 C700,138 760,158 830,140 C920,118 1040,152 1152,146" />
    <path class="st g2 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M612,163 C702,144 760,163 832,145 C920,124 1040,157 1150,151" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.6" d="M1208,142 C1280,136 1330,116 1470,110" />

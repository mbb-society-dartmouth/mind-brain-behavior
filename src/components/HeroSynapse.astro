---
// The home hero: a loose network of interconnected neurons drawn as a
// time-lapse sketch in colored pencil and watercolor. Hand-authored paths,
// wobbly retraced outlines, no straight segments, no glow, no uniform sizes.
// Stand-in for a commissioned drawing (see docs/TODO.md).
---
<svg
  class="synapse"
  viewBox="0 0 1440 600"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="A loose, hand-drawn network of neurons: cell bodies linked by branching axons and dendrites, with watercolor pools behind them."
>
  <!-- Watercolor pools, behind everything -->
  <g class="pools">
    <path class="pool" style="--po:.14" fill="var(--green)" d="M520,130 C540,84 640,72 692,110 C744,148 726,214 660,232 C594,250 500,176 520,130 Z" />
    <path class="pool" style="--po:.13" fill="var(--wood)" d="M845,132 C880,98 968,104 990,148 C1012,192 960,232 898,222 C836,212 812,164 845,132 Z" />
    <path class="pool" style="--po:.11" fill="var(--wood)" d="M180,120 C210,80 310,84 336,132 C362,180 310,222 240,214 C170,206 150,160 180,120 Z" />
    <path class="pool" style="--po:.12" fill="var(--green)" d="M1120,110 C1146,72 1240,76 1264,120 C1288,164 1240,204 1178,196 C1116,188 1094,148 1120,110 Z" />
    <path class="pool" style="--po:.11" fill="var(--green)" d="M170,430 C192,394 280,392 308,432 C336,472 296,514 234,508 C172,502 148,466 170,430 Z" />
    <path class="pool" style="--po:.11" fill="var(--wood)" d="M630,430 C650,398 730,396 754,432 C778,468 742,504 688,498 C634,492 610,462 630,430 Z" />
    <path class="pool" style="--po:.14" fill="var(--green)" d="M330,290 C356,248 448,250 474,296 C500,342 452,382 388,374 C324,366 304,332 330,290 Z" />

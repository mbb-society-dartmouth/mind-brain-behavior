    <path class="st g3 ap-track" pathLength="1" stroke="var(--wood-deep)" stroke-width="2.2" d="M600,200 C616,246 660,266 690,296 C710,316 730,320 748,318" />
    <path class="st g3 ghost" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.1" d="M604,197 C620,243 664,262 694,292 C713,311 731,315 746,313" />
    <path class="st g3" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.4" d="M560,30 C640,40 760,24 900,48" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.7" d="M262,470 C360,500 460,468 560,478 C590,480 610,470 628,462" />
    <path class="st g3 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1" d="M264,475 C362,504 460,473 560,483 C589,485 608,475 626,467" />

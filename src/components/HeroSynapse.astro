    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.8" d="M920,376 C940,420 990,440 1050,466 C1120,496 1180,470 1236,472" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.6" d="M840,398 C820,430 780,432 748,444" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.7" d="M690,478 C688,520 696,560 690,630" />
    <path class="st g5" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.5" d="M186,470 C130,510 80,540 -30,570" />
    <path class="st g5" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.5" d="M1310,490 C1360,510 1400,540 1470,560" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.5" d="M1190,120 C1186,80 1194,50 1186,-20" />
    <!-- second wave: the added cells' processes -->
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.5" d="M404,300 C440,260 502,222 556,192" />
    <path class="st g2" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.3" d="M372,334 C310,372 268,418 252,450" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M1008,62 C1006,38 1012,10 1004,-30" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.4" d="M1030,94 C1080,112 1128,128 1154,140" />
    <path class="st g3" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.2" d="M990,98 C952,120 924,138 904,152" />
    <path class="st g4" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.3" d="M1068,376 C1056,338 1040,304 1022,272" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M1094,408 C1140,440 1190,456 1238,466" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M120,584 C152,558 192,530 226,508" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M90,612 C40,640 4,652 -30,672" />
    <path class="st g5" pathLength="1" stroke="var(--wood-deep)" stroke-width="1.1" d="M380,656 C470,612 560,622 644,600" />
    <!-- dendrite tufts and stray sketch ticks -->
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M560,140 C548,124 546,108 552,90" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M618,132 C630,118 646,110 664,110" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M828,306 C810,292 800,278 798,260" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M900,278 C910,262 926,252 944,250" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M868,272 C866,254 872,240 884,228" />
    <path class="st g1" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M176,96 C160,84 152,70 152,52" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M262,436 C252,420 250,404 256,386" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M1322,442 C1330,426 1344,416 1362,414" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M352,296 C358,286 366,280 376,278" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M1042,68 C1050,62 1058,58 1068,58" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M1048,428 C1040,438 1036,448 1036,460" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1" d="M640,520 C650,512 662,510 674,512" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1" d="M148,548 C156,540 166,536 178,536" />
  </g>

  <!-- Cell bodies: irregular blob outlines, retraced like a sketch -->
  <g class="somas" fill="none" stroke-linecap="round">
    <path class="st g1" pathLength="1" stroke="var(--ink)" stroke-width="2.2" d="M196,104 C202,88 226,82 240,94 C254,106 252,128 236,136 C220,144 190,120 196,104 Z" />
    <path class="st g1 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M200,101 C207,86 228,80 241,91 C254,102 253,124 238,132 C223,140 193,116 200,101 Z" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="2.4" d="M566,164 C562,144 580,128 602,132 C624,136 636,158 626,176 C616,194 588,196 574,184 C566,177 568,170 566,164 Z" />
    <path class="st g2 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1.2" d="M570,161 C567,143 583,129 603,133 C623,137 634,157 625,173 C616,189 590,191 577,180 C570,174 572,167 570,161 Z" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="2.6" d="M848,314 C838,292 852,268 880,264 C908,260 932,278 934,304 C936,330 916,350 888,348 C860,346 856,332 848,314 Z" />
    <path class="st g4 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1.3" d="M853,311 C844,291 857,270 882,266 C907,262 928,279 930,302 C932,325 914,343 889,341 C864,339 860,326 853,311 Z" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="1.9" d="M1160,152 C1156,136 1170,122 1188,126 C1206,130 1214,148 1204,162 C1194,176 1164,168 1160,152 Z" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="2" d="M222,452 C218,436 232,422 250,424 C268,426 278,444 270,458 C262,472 226,468 222,452 Z" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="2" d="M646,452 C644,434 662,420 682,426 C702,432 708,454 696,466 C684,478 648,470 646,452 Z" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.9" d="M1250,470 C1248,452 1266,440 1284,446 C1302,452 1308,472 1296,484 C1284,496 1252,488 1250,470 Z" />
    <path class="st g2" pathLength="1" stroke="var(--ink)" stroke-width="2.1" d="M378,308 C376,290 394,276 414,282 C434,288 440,310 428,322 C416,334 380,326 378,308 Z" />
    <path class="st g2 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1.1" d="M382,305 C381,289 397,277 415,283 C433,289 438,308 427,319 C416,330 383,321 382,305 Z" />
    <path class="st g3" pathLength="1" stroke="var(--ink)" stroke-width="1.8" d="M994,76 C992,60 1008,48 1024,54 C1040,60 1044,78 1034,88 C1024,98 996,92 994,76 Z" />
    <path class="st g4" pathLength="1" stroke="var(--ink)" stroke-width="2" d="M1064,388 C1062,370 1080,358 1098,364 C1116,370 1120,390 1110,402 C1100,414 1066,406 1064,388 Z" />
    <path class="st g4 ghost" pathLength="1" stroke="var(--ink)" stroke-width="1" d="M1068,385 C1067,369 1083,359 1099,365 C1115,371 1118,388 1109,398 C1100,408 1069,400 1068,385 Z" />
    <path class="st g5" pathLength="1" stroke="var(--ink)" stroke-width="1.8" d="M100,596 C98,580 112,568 128,572 C144,576 150,594 140,604 C130,614 102,612 100,596 Z" />
  </g>

  <!-- Action potentials: highlights traveling the axons in overlapping waves -->
  <g fill="none" stroke-linecap="round">
    <path class="ap" pathLength="1" stroke="var(--wood)" stroke-width="3.4" d="M600,200 C616,246 660,266 690,296 C710,316 730,320 748,318" />
    <path class="ap ap-b" pathLength="1" stroke="var(--wood)" stroke-width="3.4" d="M1170,180 C1130,240 1080,250 1030,290 C990,322 950,320 916,316" />
    <path class="ap ap-c" pathLength="1" stroke="var(--wood)" stroke-width="3" d="M610,158 C700,138 760,158 830,140 C920,118 1040,152 1152,146" />
    <path class="ap ap-d" pathLength="1" stroke="var(--wood)" stroke-width="3" d="M262,470 C360,500 460,468 560,478 C590,480 610,470 628,462" />
    <path class="ap ap-e" pathLength="1" stroke="var(--wood)" stroke-width="2.8" d="M238,128 C310,158 360,142 430,168 C480,186 530,172 562,166" />
    <path class="ap ap-f" pathLength="1" stroke="var(--wood)" stroke-width="2.8" d="M920,376 C940,420 990,440 1050,466 C1120,496 1180,470 1236,472" />
  </g>

  <!-- Neurotransmitters drifting across the synaptic gaps -->
  <g class="dots">
    <circle class="dot da" r="3.5" fill="var(--wood-deep)" style="offset-path: path('M752,318 C770,320 786,316 800,310')" />
    <circle class="dot db" r="3" fill="var(--wood-deep)" style="offset-path: path('M750,328 C766,330 780,328 794,322')" />
    <circle class="dot dc" r="2.5" fill="var(--green)" style="offset-path: path('M754,308 C770,310 784,306 796,300')" />
    <circle class="dot da" r="3.5" fill="var(--ink)" style="offset-path: path('M632,460 C640,458 648,456 654,454')" />
    <circle class="dot dc" r="3" fill="var(--wood-deep)" style="offset-path: path('M634,470 C642,468 650,466 656,463')" />
    <circle class="dot db" r="3" fill="var(--wood-deep)" style="offset-path: path('M1240,472 C1246,472 1250,472 1256,472')" />
    <circle class="dot da" r="3" fill="var(--wood-deep)" style="offset-path: path('M918,320 C910,330 900,338 892,344')" />
    <circle class="dot dc" r="2.5" fill="var(--ink)" style="offset-path: path('M924,328 C916,336 908,344 900,350')" />
    <circle class="dot db" r="3" fill="var(--ink)" style="offset-path: path('M560,194 C554,190 548,186 542,182')" />
    <circle class="dot da" r="2.5" fill="var(--green)" style="offset-path: path('M564,186 C558,182 552,178 546,174')" />
    <circle class="dot dc" r="3" fill="var(--wood-deep)" style="offset-path: path('M1156,146 C1162,146 1168,147 1174,148')" />
    <circle class="dot db" r="2.5" fill="var(--wood-deep)" style="offset-path: path('M1022,270 C1017,262 1013,254 1009,246')" />
  </g>
</svg>

<style>
  .synapse {
    width: 100%;
    height: 100%;
  }
  .ghost { opacity: 0.35; }

  /* 16s loop: sketch on over ~7s in an irregular order, then a long hold. */
  .g1 { animation: draw-g1 16s linear infinite; }
  .g2 { animation: draw-g2 16s linear infinite; }
  .g3 { animation: draw-g3 16s linear infinite; }
  .g4 { animation: draw-g4 16s linear infinite; }
  .g5 { animation: draw-g5 16s linear infinite; }
  .st { stroke-dasharray: 1; }
  @keyframes draw-g1 { 0%, 2% { stroke-dashoffset: 1; } 12%, 100% { stroke-dashoffset: 0; } }
  @keyframes draw-g2 { 0%, 8% { stroke-dashoffset: 1; } 21%, 100% { stroke-dashoffset: 0; } }
  @keyframes draw-g3 { 0%, 15% { stroke-dashoffset: 1; } 28%, 100% { stroke-dashoffset: 0; } }
  @keyframes draw-g4 { 0%, 23% { stroke-dashoffset: 1; } 36%, 100% { stroke-dashoffset: 0; } }
  @keyframes draw-g5 { 0%, 31% { stroke-dashoffset: 1; } 44%, 100% { stroke-dashoffset: 0; } }

  /* Watercolor arrives after the lines, like a wash over a finished sketch */
  .pool { animation: pool-in 16s linear infinite; }
  @keyframes pool-in {
    0%, 36% { opacity: 0; }
    52%, 100% { opacity: var(--po, 0.12); }
  }

  /* Dots cross the gaps in slow waves during the hold */
  .dot { opacity: 0; }
  .da { animation: drift-a 16s linear infinite; }
  .db { animation: drift-b 16s linear infinite; }
  .dc { animation: drift-c 16s linear infinite; }
  @keyframes drift-a {
    0%, 50% { offset-distance: 0%; opacity: 0; }
    52% { opacity: 0.85; }
    66% { opacity: 0.85; }
    68%, 100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes drift-b {
    0%, 60% { offset-distance: 0%; opacity: 0; }
    62% { opacity: 0.85; }
    76% { opacity: 0.85; }
    78%, 100% { offset-distance: 100%; opacity: 0; }
  }
  @keyframes drift-c {
    0%, 70% { offset-distance: 0%; opacity: 0; }
    72% { opacity: 0.85; }
    86% { opacity: 0.85; }
    88%, 100% { offset-distance: 100%; opacity: 0; }
  }

  /* Soft highlights travel the axons in overlapping waves */
  .ap { stroke-dasharray: 0.055 0.945; stroke-dashoffset: 1.055; opacity: 0; animation: ap-run 16s linear infinite; }
  .ap-b { animation-name: ap-run-b; }
  .ap-c { animation-name: ap-run-c; }
  .ap-d { animation-name: ap-run-d; }
  .ap-e { animation-name: ap-run-e; }
  .ap-f { animation-name: ap-run-f; }
  @keyframes ap-run {
    0%, 46% { stroke-dashoffset: 1.055; opacity: 0; }
    48% { opacity: 0.7; }
    66% { opacity: 0.7; }
    68%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }
  @keyframes ap-run-b {
    0%, 54% { stroke-dashoffset: 1.055; opacity: 0; }
    56% { opacity: 0.7; }
    74% { opacity: 0.7; }
    76%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }
  @keyframes ap-run-c {
    0%, 60% { stroke-dashoffset: 1.055; opacity: 0; }
    62% { opacity: 0.6; }
    82% { opacity: 0.6; }
    84%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }
  @keyframes ap-run-d {
    0%, 66% { stroke-dashoffset: 1.055; opacity: 0; }
    68% { opacity: 0.6; }
    88% { opacity: 0.6; }
    90%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }
  @keyframes ap-run-e {
    0%, 74% { stroke-dashoffset: 1.055; opacity: 0; }
    76% { opacity: 0.55; }
    94% { opacity: 0.55; }
    96%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }
  @keyframes ap-run-f {
    0%, 80% { stroke-dashoffset: 1.055; opacity: 0; }
    82% { opacity: 0.55; }
    97% { opacity: 0.55; }
    99%, 100% { stroke-dashoffset: -0.055; opacity: 0; }
  }

  /* Reduced motion: the fully drawn network as a single static frame */
  @media (prefers-reduced-motion: reduce) {
    .st, .pool, .dot, .ap { animation: none; }
    .st { stroke-dashoffset: 0; }
    .pool { opacity: var(--po, 0.12); }
    .dot, .ap { display: none; }
  }
</style>

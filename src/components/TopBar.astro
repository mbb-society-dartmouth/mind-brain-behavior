---
interface Props { current?: string }
const { current = '' } = Astro.props;
const items = [
  { label: 'Our mission', href: '/mission' },
  { label: 'What we do', href: '/what-we-do' },
  { label: 'Neurotech team', href: '/neurotech' },
  { label: 'Term calendar', href: '/calendar' },
  { label: 'Contact', href: '/contact' },
];
---
<header class="topbar">
  <div class="topbar-inner">
    <a
      class="dartmouth"
      href="https://home.dartmouth.edu"
      aria-label="Dartmouth College home"
    >
      <img src="/media/dartmouth-logo.webp" alt="Dartmouth College" height="152" width="152" />
    </a>

    <a class="home-link" href="/" aria-label="Home" aria-current={current === '/' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3.5 10.6 12 3.6l8.5 7" />
        <path d="M5.6 9.6V20.2h12.8V9.6" />
        <path d="M9.9 20.2v-5.8h4.2v5.8" />
      </svg>
    </a>

    <nav class="nav" aria-label="Site">
      {items.map((it) => (
        <a
          class="navlink"
          href={it.href}
          aria-current={current === it.href ? 'page' : undefined}
        >{it.label}</a>
      ))}
    </nav>

    <button class="menu-btn" id="menu-open" aria-haspopup="dialog">Menu</button>
  </div>
</header>

<dialog class="menu-dialog" id="menu-dialog" aria-label="Site menu">
  <nav aria-label="Site">
    <a class="menu-item" href="/" aria-current={current === '/' ? 'page' : undefined}>Home</a>
    {items.map((it) => (
      <a
        class="menu-item"
        href={it.href}
        aria-current={current === it.href ? 'page' : undefined}
      >{it.label}</a>
    ))}
  </nav>
  <button class="menu-item menu-close" id="menu-close">Close</button>
</dialog>

<style>
  .topbar {
    height: var(--topbar-h);
    background: var(--white);
    border-bottom: 1px solid var(--ink);
    z-index: 10;
    position: relative;
  }
  .topbar-inner {
    height: 100%;
    display: flex;
    align-items: center;
    padding-inline: var(--gutter);
  }
  /* Dartmouth logo: unmodified, large enough to actually read */
  .dartmouth { display: flex; align-items: center; margin-right: auto; }
  .dartmouth img { height: 152px; width: auto; }

  .home-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--ink);
    margin-right: var(--s2);
  }
  .home-link[aria-current='page'] { color: var(--wood-deep); }

  .menu-btn {
    display: none;
    background: var(--white);
    border: 1.5px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    padding: 10px 18px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    min-height: 44px;
    transition: transform var(--speed-press) ease-out, box-shadow var(--speed-press) ease-out,
                background var(--speed-press) ease-out, color var(--speed-press) ease-out;
  }
  .menu-btn:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--black); background: var(--wood); color: var(--white); }
  .menu-btn:active { transform: translate(4px, 4px); box-shadow: none; }

  /* Nav labels as chunky keys */
  .nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .navlink {
    display: inline-block;
    padding: 11px 18px;
    background: var(--white);
    border: 1.5px solid var(--black);
    box-shadow: 4px 4px 0 var(--black);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    white-space: nowrap;
    transition: transform var(--speed-press) ease-out, box-shadow var(--speed-press) ease-out,
                background var(--speed-press) ease-out, color var(--speed-press) ease-out;
  }
  .navlink:hover, .navlink:focus-visible {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--black);
    background: var(--wood);
    color: var(--white);
  }
  .navlink:active {
    transform: translate(4px, 4px);
    box-shadow: none;
  }
  .navlink[aria-current='page'] {
    background: var(--wood);
    color: var(--white);
  }

  @media (max-width: 1099px) {
    .nav { display: none; }
    .menu-btn { display: block; }
  }
  @media (max-width: 767px) {
    .dartmouth img { height: 88px; }
  }

  /* Mobile menu: full-screen paper panel */
  .menu-dialog {
    border: 0;
    padding: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    background: var(--paper);
    display: none;
    flex-direction: column;
  }
  .menu-dialog[open] { display: flex; }
  .menu-dialog nav { display: flex; flex-direction: column; flex: 1; }
  .menu-item {
    display: flex;
    align-items: center;
    height: 72px;
    padding-inline: var(--gutter);
    background: var(--grey);
    color: var(--white);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
    border: 0;
    border-bottom: 1px solid var(--black);
    cursor: pointer;
    text-align: left;
    transition: transform var(--speed-press) ease-out, background var(--speed-press) ease-out;
  }
  .menu-item:active { background: var(--wood); transform: translateY(3px); }
  .menu-item[aria-current='page'] { box-shadow: inset 4px 0 0 var(--wood); }
  .menu-close {
    margin-top: auto;
    border-bottom: 0;
    border-top: 1px solid var(--black);
    background: var(--black);
  }
</style>

<script>
  const dialog = document.getElementById('menu-dialog') as HTMLDialogElement | null;
  const openBtn = document.getElementById('menu-open');
  const closeBtn = document.getElementById('menu-close');
  openBtn?.addEventListener('click', () => dialog?.showModal());
  closeBtn?.addEventListener('click', () => dialog?.close());
  // Scroll lock while open
  dialog?.addEventListener('toggle', () => {
    document.documentElement.style.overflow = dialog.open ? 'hidden' : '';
  });
</script>

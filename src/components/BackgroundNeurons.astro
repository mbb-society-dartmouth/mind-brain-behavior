---
// Inner-page background: a sparse watercolor neuron network, very low
// opacity, fixed behind the content. Weighted toward the right and the
// edges so the left text column stays calm. Two slow traveling highlights
// fire on a long loop; reduced motion gets the static frame.
---
<div class="bg-neurons" aria-hidden="true">
  <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <g class="bg-pools">
      <path fill="var(--green)" opacity="0.07" d="M1120,170 C1160,110 1290,116 1326,186 C1362,256 1290,320 1192,306 C1094,292 1080,230 1120,170 Z" />
      <path fill="var(--wood)" opacity="0.07" d="M1010,640 C1050,580 1190,588 1224,662 C1258,736 1178,800 1078,784 C978,768 970,700 1010,640 Z" />
      <path fill="var(--paper)" opacity="0.5" d="M150,700 C190,640 330,646 366,716 C402,786 322,850 222,836 C122,822 110,760 150,700 Z" />
      <path fill="var(--wood)" opacity="0.05" d="M180,120 C210,80 310,84 336,132 C362,180 310,222 240,214 C170,206 150,160 180,120 Z" />
      <path fill="var(--green)" opacity="0.05" d="M640,420 C670,380 760,384 786,430 C812,476 762,516 696,510 C630,504 610,460 640,420 Z" />
    </g>
    <g fill="none" stroke-linecap="round">
      <path class="bg-fire-track" stroke="var(--wood-deep)" stroke-width="1.4" opacity="0.16" pathLength="1" d="M1480,90 C1380,130 1300,120 1236,170 C1200,198 1180,220 1176,246" />
      <path stroke="var(--ink)" stroke-width="1.2" opacity="0.12" pathLength="1" d="M1190,290 C1160,380 1100,420 1080,500 C1064,560 1070,600 1076,632" />
      <path class="bg-fire-track2" stroke="var(--green)" stroke-width="1.4" opacity="0.15" pathLength="1" d="M1110,700 C1040,760 960,780 870,840 C820,872 790,890 770,920" />
      <path stroke="var(--wood-deep)" stroke-width="1.2" opacity="0.13" pathLength="1" d="M1230,254 C1300,300 1360,300 1470,350" />
      <path stroke="var(--ink)" stroke-width="1.1" opacity="0.10" d="M260,170 C340,220 420,210 500,260 C560,296 600,340 630,400" />
      <path stroke="var(--green)" stroke-width="1.2" opacity="0.11" d="M230,120 C240,60 236,20 246,-30" />
      <path stroke="var(--ink)" stroke-width="1.1" opacity="0.10" d="M700,470 C720,560 700,640 720,740 C730,800 726,860 722,930" />
      <path stroke="var(--wood-deep)" stroke-width="1.1" opacity="0.10" d="M660,440 C560,500 440,520 350,600 C300,644 270,690 250,740" />
      <path stroke="var(--ink)" stroke-width="1" opacity="0.09" d="M240,760 C160,800 100,810 -30,860" />
      <path stroke="var(--ink)" stroke-width="1" opacity="0.09" d="M-30,240 C60,220 140,190 210,160" />
      <!-- somas -->
      <path stroke="var(--ink)" stroke-width="1.5" opacity="0.14" d="M1186,252 C1180,234 1196,218 1216,222 C1236,226 1244,248 1232,262 C1220,276 1192,270 1186,252 Z" />
      <path stroke="var(--ink)" stroke-width="1.4" opacity="0.13" d="M1078,650 C1072,632 1088,616 1108,620 C1128,624 1136,646 1124,660 C1112,674 1084,668 1078,650 Z" />
      <path stroke="var(--ink)" stroke-width="1.3" opacity="0.12" d="M234,138 C228,122 242,108 260,112 C278,116 284,136 274,148 C264,160 240,154 234,138 Z" />
      <path stroke="var(--ink)" stroke-width="1.3" opacity="0.12" d="M666,432 C660,416 674,402 692,406 C710,410 716,430 706,442 C696,454 672,448 666,432 Z" />
      <path stroke="var(--ink)" stroke-width="1.2" opacity="0.11" d="M246,748 C240,732 254,718 272,722 C290,726 296,746 286,758 C276,770 252,764 246,748 Z" />
      <!-- tufts -->
      <path stroke="var(--ink)" stroke-width="1" opacity="0.10" d="M1218,214 C1224,198 1236,188 1252,184" />
      <path stroke="var(--ink)" stroke-width="1" opacity="0.10" d="M1070,636 C1058,624 1050,610 1048,594" />
      <path stroke="var(--ink)" stroke-width="1" opacity="0.09" d="M282,124 C294,112 308,106 324,106" />
    </g>
    <!-- slow firing: a soft highlight travels a strand every half minute -->
    <g fill="none" stroke-linecap="round">
      <path class="bg-fire" pathLength="1" stroke="var(--wood)" stroke-width="2.4" d="M1480,90 C1380,130 1300,120 1236,170 C1200,198 1180,220 1176,246" />
      <path class="bg-fire bg-fire--late" pathLength="1" stroke="var(--green)" stroke-width="2.4" d="M1110,700 C1040,760 960,780 870,840 C820,872 790,890 770,920" />
    </g>
  </svg>
</div>

<style>
  .bg-neurons {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .bg-neurons svg { width: 100%; height: 100%; }

  .bg-fire {
    stroke-dasharray: 0.08 0.92;
    stroke-dashoffset: 1.08;
    opacity: 0;
    animation: bg-fire-run 28s linear infinite;
  }
  .bg-fire--late { animation-name: bg-fire-run-late; }
  @keyframes bg-fire-run {
    0%, 18% { stroke-dashoffset: 1.08; opacity: 0; }
    20% { opacity: 0.35; }
    38% { opacity: 0.35; }
    40%, 100% { stroke-dashoffset: -0.08; opacity: 0; }
  }
  @keyframes bg-fire-run-late {
    0%, 58% { stroke-dashoffset: 1.08; opacity: 0; }
    60% { opacity: 0.35; }
    78% { opacity: 0.35; }
    80%, 100% { stroke-dashoffset: -0.08; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg-fire { animation: none; display: none; }
  }
</style>

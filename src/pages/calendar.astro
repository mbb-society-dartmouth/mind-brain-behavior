---
import Base from '../layouts/Base.astro';
import CalendarTable from '../components/CalendarTable.astro';
import BlockButton from '../components/BlockButton.astro';
import cal from '../data/calendar.json';
---
<Base
  title="Term calendar | Mind, Brain, Behavior Society"
  description="Fall 2026 events, week by week: lab tour, VR workshop, career workshop, social, and guest lecture."
  path="/calendar"
>
  <main class="wrap">
    <h1 class="page-title">Term calendar</h1>
    <p class="term-label">{cal.label}</p>
    <p class="note">{cal.note}</p>

    <section class="section">
      <CalendarTable />
    </section>

    <section class="cta-section">
      <p><BlockButton href="/contact">Get in touch</BlockButton></p>
    </section>
  </main>
</Base>

<style>
  .term-label {
    font-size: var(--size-section);
    font-weight: 500;
    font-style: italic;
    margin-bottom: var(--s2);
  }
  .cta-section { margin-block: var(--s5); }
  .note { color: var(--grey-mid); font-size: 15px; }
  .section { margin-top: var(--s4); }
</style>
